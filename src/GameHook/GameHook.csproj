<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Terraria targets: .NET Framework 4.0 Client Profile -->
    <TargetFramework>net40</TargetFramework>
    <RootNamespace>GameHook</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- cCompile against the game, but dont copy it to output to prevent duplication -->
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)\Terraria.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- for Vector2 -->
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(windir)\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckTerrariaDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(TerrariaDir)\Terraria.exe')"
           Text="Terraria.exe not found in TerrariaDir='$(TerrariaDir)'. Create local.props at the repo root (see Directory.Build.props)." />
  </Target>

</Project>
